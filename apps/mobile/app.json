{
  "expo": {
    "name": "dvote",
    "slug": "dvote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dvote.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dvote.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "dvote uses your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "dvote uses your location while the app is open to show the coffee shops nearest to you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DvotePoints",
              "displayName": "My points",
              "description": "Your points at your top 3 shops.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "DvoteQr",
              "displayName": "Collect points",
              "description": "Tap to show your dvote QR at the counter.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall"
                ]
              }
            }
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DvotePoints",
              "label": "My points",
              "description": "Your points at your top 3 shops.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "DvoteQr",
              "label": "Collect points",
              "description": "Tap to show your dvote QR at the counter.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2
            }
          ]
        }
      ],
      "./plugins/with-androidx-work-fix"
    ],
    "scheme": "dvote",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "output": "single"
    },
    "backgroundColor": "#F2F2F7",
    "experiments": {
      "typedRoutes": true
    }
  }
}

{
  "expo": {
    "name": "dvote",
    "slug": "dvote",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dvote.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dvote.app"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "dvote uses your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "dvote uses your location while the app is open to show the coffee shops nearest to you.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "scheme": "dvote",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "output": "single"
    },
    "backgroundColor": "#F2F2F7",
    "experiments": {
      "typedRoutes": true
    }
  }
}

VITE_API_URL=http://localhost:3000
# the customer website (apps/web): what the QR / NFC at the till opens; production: https://m.dvote.co
VITE_WEB_URL=http://localhost:5174
# Production only: this app is served at both addresses; each lets in only its own accounts.
# Leave empty locally (then everyone can sign in here).
# VITE_ADMIN_URL=https://admin.dvote.co
# VITE_MERCHANT_URL=https://merchant.dvote.co
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# publishable key only (public). Never the secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./../dashboard/src/*"] }
  },
  "include": ["playwright.config.ts", "lib", "tests"]
}

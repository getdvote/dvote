# Copy to .env and fill in. Never commit .env.

# Local Postgres (Prisma + the API)
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dvote

# Supabase project URL (Project Settings -> API). Public value, not a secret.
# The API only needs this: it checks tokens against the project's public keys.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional
# PORT=3000
# NODE_ENV=development
# CORS_ORIGINS=http://localhost:5173

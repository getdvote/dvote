# Copy to .env and fill in. Never commit .env.

# App database (Prisma + the API): Supabase Postgres, Connect -> Session pooler (IPv4).
# Password: letters and numbers only (symbols like @ break the URL).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Local Postgres for the e2e tests (they refuse any non-local database).
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/dvote

# Supabase project URL (Project Settings -> API). Public value, not a secret.
# Tokens are checked against the project's public keys (no secret needed for that).
SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase SECRET key (Project Settings -> API Keys -> Secret keys). SERVER ONLY, never in an app.
# Needed to invite staff; without it POST /api/vendor/staff returns 503.
SUPABASE_SECRET_KEY=

# Customer feedback → Google Sheet, through the Apps Script web app in
# google-apps-script/feedback.gs (setup steps at the top of that file).
# Without these, POST /api/app/feedback returns 503.
FEEDBACK_SHEET_URL=
FEEDBACK_SHEET_SECRET=

# Optional
# ADMIN_MFA_REQUIRED=true   # set false ONLY locally to skip admin two-factor
# STAFF_INVITE_REDIRECT_URL=http://localhost:3000/dev/staff.html
# PORT=3000
# NODE_ENV=development
# Browser apps allowed to call the API (comma-separated). The staff web app runs on 8081.
# CORS_ORIGINS=http://localhost:8081,http://localhost:5173
# Websites shown on the admin "System status" page ("Name=url" pairs, comma-separated).
# STATUS_TARGETS=Admin & vendor dashboard=http://localhost:5173,Staff web app=http://localhost:8081,Customer app (web preview)=http://localhost:8082

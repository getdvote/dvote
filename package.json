{
  "name": "dvote",
  "private": true,
  "description": "dvote coffee loyalty platform monorepo",
  "scripts": {
    "api:install": "npm --prefix apps/api install",
    "api:dev": "npm --prefix apps/api run start:dev",
    "api:build": "npm --prefix apps/api run build",
    "api:test": "npm --prefix apps/api run test",
    "api:test:e2e": "npm --prefix apps/api run test:e2e",
    "api:lint": "npm --prefix apps/api run lint",
    "admin:create": "npm --prefix apps/api run admin:create --",
    "staff:install": "npm --prefix apps/staff install",
    "staff:web": "npm --prefix apps/staff run web",
    "staff:start": "npm --prefix apps/staff run start",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:start:clear": "npm --prefix apps/mobile run start -- --clear",
    "staff:start:clear": "npm --prefix apps/staff run start -- --clear"
  }
}
